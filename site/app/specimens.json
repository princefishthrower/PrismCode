{
  "hero-title": {
    "fonts": ["TrueShuffle"],
    "color": "#fff9eb",
    "lineHeight": 1.2,
    "lines": ["<PrismCode>"]
  },
  "hero-code": {
    "fonts": ["TrueShuffle"],
    "color": "#fff9eb",
    "lineHeight": 1.5,
    "lines": [
      "for (let n = 1; n <= 100; n++) {",
      "  const fizz = n % 3 === 0;",
      "  const buzz = n % 5 === 0;",
      "  console.log(",
      "    fizz && buzz ? 'FizzBuzz' :",
      "    fizz ? 'Fizz' :",
      "    buzz ? 'Buzz' : n",
      "  );",
      "}"
    ]
  },
  "card-title": {
    "color": "#e2e8f0",
    "lineHeight": 1.25,
    "lines": ["Aa Bb Cc 09"]
  },
  "card-code": {
    "color": "#e2e8f0",
    "lineHeight": 1.5,
    "lines": [
      "const add = (n: number) => {",
      "  return n >= 0 ? n + 1 : 0;",
      "};"
    ]
  },
  "card-ligatures": {
    "color": "#e2e8f0",
    "lineHeight": 1.5,
    "lines": ["=>  ->  >=  <=  !=  ===  !==  &&  ||  ++  --  />"]
  }
